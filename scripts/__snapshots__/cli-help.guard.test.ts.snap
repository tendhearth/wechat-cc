USAGE wechat-cc access list|remove

COMMANDS

    list    Show access.json: admins / trusted / allowFrom                                                           
  remove    Remove a userId from allowFrom (admins refuse — self-lockout guard). Takes effect within ~5s, no restart.

Use wechat-cc access <command> --help for more information about a command.

"
`;

exports[`cli.ts --help 快照(逐字节) > account --help > account export --help 1`] = `
"Export a bound bot (encrypted) so another machine can drive it — no re-scan (account export)

USAGE account export [OPTIONS] --passphrase=<passphrase>

OPTIONS

          --bot-id=<bot_id>    Which account (default: the sole bound one)                 
  --passphrase=<passphrase>    Encrypts the bundle (you type the same on import) (Required)
                --out=<out>    Output file (default: <botId>.wccaccount)                   
                     --json    JSON envelope                                               


"
`;

exports[`cli.ts --help 快照(逐字节) > account --help > account import --help 1`] = `
"Import an account bundle from another machine — drive the same bot without re-scanning (account import)

USAGE account import [OPTIONS] <FILE> --passphrase=<passphrase>

ARGUMENTS

  FILE=<file>    The .wccaccount bundle (Required)

OPTIONS

  --passphrase=<passphrase>    The passphrase used on export (Required)
                     --json    JSON envelope                           


"
`;

