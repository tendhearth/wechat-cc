exports[`cli.ts --help 快照(逐字节) > account --help 1`] = `
"Account management (export/import + takeover for multi-device, decommission a bound bot) (wechat-cc account v1.7.1 (dev))

USAGE wechat-cc account remove|export|import|takeover

COMMANDS

    remove    Decommission a bound bot — wipes account dir + related state. Restart daemon afterwards.  
    export    Export a bound bot (encrypted) so another machine can drive it — no re-scan               
    import    Import an account bundle from another machine — drive the same bot without re-scanning    
  takeover    Take over the bot session on THIS machine (re-poll a stood-by account) — no daemon restart

Use wechat-cc account <command> --help for more information about a command.

"
`;

