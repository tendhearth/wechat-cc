USAGE selftest workbench [OPTIONS] --executor=<executor>

OPTIONS

      --executor=<executor>    执行者 provider id(claude / codex / cursor / agy / …) (Required)                                           
                    --image    带一张自生成的红方块 PNG 附件,问模型图里是什么颜色(替换 activity_seen/permission_roundtrip/file_written 三项为 answer_mentions_red)
                   --resume    额外走一次 continue,核对续接(resume_replied)                                                                     
                     --json    JSON 输出(SelftestReport),不输出人读版                                                                          
  --timeout-ms=<timeout_ms>    总超时,毫秒(缺省 240000)                                                                                       
                     --keep    保留 scratch 项目目录,不在跑完后删除                                                                                 


"
`;

