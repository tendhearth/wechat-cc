OPTIONS

      --id=<id>    Hand id(小写 slug)。默认从码里带来的机器名推 —— 通常不用填  
  --name=<name>    显示名(如 家里)。默认用手那台的机器名 —— 微信里说「让<名字>…」就派给它
         --json    JSON envelope                           


"
`;

