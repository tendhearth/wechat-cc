exports[`cli.ts --help 快照(逐字节) > provider --help > provider set --help 1`] = `
"Switch agent provider (claude|codex|cursor|openai|gemini|agy), optionally with --model + --base-url + --unattended + --auto-start + --close-stops-daemon (provider set)

USAGE provider set [OPTIONS] <PROVIDER>

ARGUMENTS

  PROVIDER=<claude|codex|cursor|openai|gemini|agy>    claude | codex | cursor | openai | gemini | agy (Required)

OPTIONS

                           --model=<model>    Override default model (openai: required the first time, unless already stored)                                                
  --base-url=<https://api.deepseek.com/v1>    OpenAI-compatible API base URL — openai only, e.g. https://api.deepseek.com/v1 (required the first time, unless already stored)
                 --unattended=<true|false>    true | false | yes | no | on | off (omit to leave unchanged)                                                                   
                 --auto-start=<true|false>    true | false (omit to leave unchanged) — register service for boot/login auto-start                                            
         --close-stops-daemon=<true|false>    true | false (omit to leave unchanged) — when true, closing the GUI window stops the daemon                                    


"
`;

exports[`cli.ts --help 快照(逐字节) > provider --help > provider show --help 1`] = `
"Show selected agent provider (provider show)

USAGE provider show [OPTIONS] 

OPTIONS

  --json    JSON envelope


"
`;

exports[`cli.ts --help 快照(逐字节) > provider --help 1`] = `
