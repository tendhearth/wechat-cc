exports[`cli.ts --help 快照(逐字节) > hand --help > hand accept --help 1`] = `
"Accept a brain that may delegate tasks to THIS machine (run on the HAND) (hand accept)

USAGE hand accept [OPTIONS] --token=<token>

OPTIONS

          --token=<token>    The shared pairing token (same as on the brain) (Required)                                     
    --brain-id=<brain_id>    Brain's a2a self-id (default wechat-cc; must match its WECHAT_A2A_SELF_ID) (Default: wechat-cc)
  --brain-url=<brain_url>    Optional: brain's A2A url (only for the hand to call back later)                               
                   --json    JSON envelope                                                                                  


"
`;

exports[`cli.ts --help 快照(逐字节) > hand --help > hand add --help 1`] = `
"Register a hand the brain can delegate tasks to (run on the BRAIN) (hand add)

USAGE hand add [OPTIONS] <ID> <URL> --token=<token>

ARGUMENTS

    ID=<id>    Hand id — lowercase slug, e.g. home (Required)                       
  URL=<url>    Hand's A2A url (tailnet), e.g. http://home.ts.net:7000/a2a (Required)

OPTIONS

    --name=<name>    Display name (e.g. 家里) — used in 「让<name>执行 X」                   
  --token=<token>    Shared pairing token (≥16 chars; the SAME on the hand) (Required)
           --json    JSON envelope                                                    


"
`;

exports[`cli.ts --help 快照(逐字节) > hand --help > hand invite --help 1`] = `
"一条命令把这台配成「手」:自动开 A2A 监听 + 重启 + 出配对码(在 HAND 那台跑) (hand invite)

USAGE hand invite [OPTIONS] 

OPTIONS

  --host=<host>    强制绑定到这个地址(默认自动挑:Tailscale 优先,其次局域网网卡)           
  --port=<port>    A2A 端口(默认 8717)                                 
    --url=<url>    完全覆盖这台手的 A2A url(不碰配置、不重启)                      
       --cancel    Cancel any pending invite instead of minting one
         --json    JSON envelope                                   


"
`;

exports[`cli.ts --help 快照(逐字节) > hand --help > hand join --help 1`] = `
