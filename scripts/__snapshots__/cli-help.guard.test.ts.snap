exports[`cli.ts --help 快照(逐字节) > agent --help > agent test --help 1`] = `
"Send a synthetic notify to validate the inbound→chat path (default) or outbound (--outbound) (agent test)

USAGE agent test [OPTIONS] <ID>

ARGUMENTS

  ID=<agent-id>    Registered agent id (Required)

OPTIONS

  --text=<text>    Test message text (default: "test from <id> via wechat-cc")  
     --outbound    Test outbound (wechat-cc → external agent) instead of inbound


"
`;

exports[`cli.ts --help 快照(逐字节) > agent --help 1`] = `
"A2A agent registry — register, inspect, pause, resume, remove, and view activity (wechat-cc agent v1.7.1 (dev))

USAGE wechat-cc agent inspect|add|list|pause|resume|remove|activity|info|edit|test

COMMANDS

   inspect    Fetch Agent Card and print metadata                                                         
       add    Register a new A2A agent (fetches Agent Card, generates inbound API key)                    
      list    List registered A2A agents                                                                  
     pause    Pause inbound/outbound for an agent                                                         
    resume    Un-pause an agent                                                                           
    remove    Drop agent registration                                                                     
  activity    Print recent A2A events for an agent (newest first)                                         
      info    Show A2A server status (base URL + registered agents) — for sharing URL with external agents
      edit    Edit a registered A2A agent (rotate keys, rename, change URL) without remove + re-add       
      test    Send a synthetic notify to validate the inbound→chat path (default) or outbound (--outbound)

Use wechat-cc agent <command> --help for more information about a command.

"
`;

