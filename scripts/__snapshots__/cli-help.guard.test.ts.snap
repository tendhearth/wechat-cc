exports[`cli.ts --help 快照(逐字节) > agent --help > agent add --help 1`] = `
"Register a new A2A agent (fetches Agent Card, generates inbound API key) (agent add)

USAGE agent add [OPTIONS] <URL>

ARGUMENTS

  URL=<url>    Agent base URL (Required)

OPTIONS

                        --id=<id>    Explicit agent id slug (default: slugified name from Agent Card)
  --name-override=<name_override>    Override the display name from the Agent Card                   
    --outbound-key=<outbound_key>    Bearer key to send when wechat-cc calls out to this agent       


"
`;

exports[`cli.ts --help 快照(逐字节) > agent --help > agent edit --help 1`] = `
"Edit a registered A2A agent (rotate keys, rename, change URL) without remove + re-add (agent edit)

USAGE agent edit [OPTIONS] <ID>

ARGUMENTS

  ID=<agent-id>    Agent id (Required)

OPTIONS

                  --name=<name>    New display name                                                    
                    --url=<url>    New URL                                                             
  --outbound-key=<outbound_key>    Rotate outbound API key (we use this when calling the agent)        
           --rotate-inbound-key    Generate a fresh inbound API key (external agent uses it to call us)


"
`;

