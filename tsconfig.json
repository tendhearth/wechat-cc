{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "lib": ["ESNext"],
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true
  },
  "include": [
    "**/*.ts",
    "src/**/*.ts",
    "types/**/*.d.ts",
    "apps/desktop/src/**/*.js"
  ],
  "exclude": ["node_modules", "docs/spike/**", "apps/desktop/playwright/**", "apps/desktop/playwright.config.ts", "apps/desktop/src-tauri/target/**", ".claude/worktrees/**", ".stryker-tmp/**", "tools/**", "apps/mobile/src/**", "apps/relay/**", "apps/app/**"]
}
