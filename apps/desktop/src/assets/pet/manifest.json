    "done": {
      "frames": [
        "states/done/000.png"
      ],
      "fps": 4,
      "loop": false,
      "next": "idle"
    },
    "companion": {
      "frames": [
        "states/companion/000.png"
      ],
      "fps": 4,
      "loop": true,
      "next": null
    },
    "sleep": {
      "frames": [
        "states/sleep/000.png"
      ],
      "fps": 4,
      "loop": true,
      "next": null
    },
    "drag": {
      "frames": [
        "states/drag/000.png"
      ],
      "fps": 4,
      "loop": false,
      "next": "idle"
    },
    "wake": {
      "frames": [
        "states/wake/000.png"
      ],
      "fps": 4,
      "loop": false,
      "next": "idle"
    },
    "error": {
      "frames": [
        "states/error/000.png"
      ],
      "fps": 4,
      "loop": false,
      "next": "idle"
