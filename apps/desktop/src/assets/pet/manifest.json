      "frames": [
        "reference/master-lit.png",
        "states/blink-half/000.png",
        "states/blink-closed/000.png",
        "states/blink-half/000.png",
        "reference/master-lit.png"
      ],
      "fps": 8,
      "loop": false,
      "next": "idle"
    },
    "look": {
      "frames": [
        "states/look-left/000.png"
      ],
      "fps": 4,
      "loop": false,
      "next": "idle"
    },
    "receive": {
      "frames": [
        "states/receive/000.png"
      ],
      "fps": 4,
      "loop": false,
      "next": "idle"
    },
    "working": {
      "frames": [
        "states/working/000.png"
      ],
      "fps": 4,
      "loop": true,
      "next": null
    },
    "thinking": {
      "frames": [
        "states/thinking/000.png"
      ],
      "fps": 4,
      "loop": true,
      "next": null
    },
    "permission": {
      "frames": [
        "states/permission/000.png"
      ],
      "fps": 4,
      "loop": true,
      "next": null
