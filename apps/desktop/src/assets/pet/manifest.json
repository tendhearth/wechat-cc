{
  "schemaVersion": 1,
  "name": "CC Desktop Pet Assets",
  "version": "1.0.0",
  "canvas": {
    "width": 512,
    "height": 512,
    "anchor": [
      0.5,
      0.91796875
    ],
    "baselinePx": 470
  },
  "canonical": {
    "unlit": "reference/master-unlit.png",
    "lit": "reference/master-lit.png",
    "rule": "Same character and silhouette; different light."
  },
  "states": {
