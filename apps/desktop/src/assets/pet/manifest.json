  "transitions": {
    "unlit-to-lit": {
      "frames": [
        "transitions/unlit-to-lit/000.png",
        "transitions/unlit-to-lit/001.png",
        "transitions/unlit-to-lit/002.png",
        "transitions/unlit-to-lit/003.png",
        "transitions/unlit-to-lit/004.png",
        "transitions/unlit-to-lit/005.png",
        "transitions/unlit-to-lit/006.png",
        "transitions/unlit-to-lit/007.png"
      ],
      "fps": 8,
      "loop": false,
      "next": "idle"
    }
  },
  "props": {
    "micro-light": "props/micro-light.png",
    "sprout": "props/sprout.png",
    "laptop": "props/laptop.png",
    "envelope": "props/envelope.png",
    "speech-bubble": "props/speech-bubble.png",
    "thought-bubble": "props/thought-bubble.png",
