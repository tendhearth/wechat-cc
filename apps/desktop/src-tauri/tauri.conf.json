{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wechat-cc",
  "version": "1.6.1",
  "identifier": "dev.wechat-cc.installer",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "bun run dev:web",
    "beforeBuildCommand": "bun run build-sidecar",
    "devUrl": "http://127.0.0.1:4174"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "wechat-cc",
        "width": 1100,
        "height": 860,
        "minWidth": 760,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost https://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost http://127.0.0.1:* http://localhost:*; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/.claude/channels/wechat/inbox/**",
          "$HOME/.claude/channels/wechat/avatars/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "deb",
      "rpm",
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/wechat-cc-cli"
    ],
    "resources": [
      "../../../plugins/"
    ],
    "macOS": {
      "dmg": {
        "background": "dmg/background.tiff",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "linux": {
      "deb": {
        "postInstallScript": "scripts/postinst.sh"
      },
      "rpm": {
        "postInstallScript": "scripts/postinst.sh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://dl.tendhearth.com/wechat-cc/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU1N0FCNDY1REQ3RDQ5NEYKUldSUFNYM2RaYlI2VmJ6d3p0dzFEQmlmTEdlZTRGTFF2V0lWOWpoYlNXblMraXlDZWduQy9tVngK"
    }
  }
}
