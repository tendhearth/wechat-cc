{
  "name": "claude-channel-wechat",
  "version": "1.7.0",
  "description": "A local-first AI companion and unified task workspace for Claude, Codex and API models, with desktop and WeChat access.",
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "wechat",
    "ilink",
    "channel"
  ],
  "homepage": "https://github.com/tendhearth/wechat-cc#readme",
  "bugs": {
    "url": "https://github.com/tendhearth/wechat-cc/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tendhearth/wechat-cc.git"
  },
  "author": "ggshr9",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "bin": {
    "wechat-cc": "./cli.ts"
  },
  "scripts": {
    "start": "bun install --no-summary && bun src/daemon/main.ts",
    "test": "bun --bun vitest run",
    "test:e2e": "bun --bun vitest run -c vitest.e2e.config.ts",
    "test:node": "vitest run -c vitest.node.config.ts",
    "test:live-cli": "WECHAT_CC_LIVE_CLI=1 bun --bun vitest run src/core/external-cli-contract.live.test.ts",
    "eval:companion": "bun eval/companion/run.ts",
    "spike:atelier-renderer": "bun scripts/atelier-renderer-spike.ts",
    "smoke:atelier-sidecar": "bun scripts/atelier-sidecar-smoke.ts",
    "build:mobile": "bun apps/mobile/build.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/mobile",
    "depcheck": "depcruise --config .dependency-cruiser.cjs src cli.ts setup.ts docs.ts log-viewer.ts apps/mobile"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^1",
    "@anthropic-ai/claude-agent-sdk": "0.2.116",
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/codex-sdk": "0.144.4",
    "ai": "^5",
    "marked": "^18.0.0",
    "qrcode-terminal": "^0.12.0",
    "yaml": "^2.9.0",
    "zod": "^4.0.0"
  },
  "optionalDependencies": {
    "@cursor/sdk": "^1.0.12",
    "@google/genai": "^2.8.0"
  },
  "devDependencies": {
    "@openai/codex": "0.144.4",
    "@types/bun": "^1.3.0",
    "citty": "^0.2.2",
    "dependency-cruiser": "^17.0.0",
    "msw": "^2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  }
}
