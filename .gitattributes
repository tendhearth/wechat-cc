# 桌宠资产包与美术源:manifest 里按 sha256 钉死字节,Windows 的 autocrlf 一改行尾全部对不上
# (2026-09-10 dev 的 windows-latest 因此 111 个 digest / geometry 错误)。整棵树按原样进出。
apps/desktop/src/assets/pet/** -text
apps/desktop/art/** -text

# 手机页源码与生成物:apps/mobile/build.test.ts 按整份文本比对「源码 → 生成物」,
# autocrlf 把两边行尾改成 CRLF 后比对必红(windows-latest)。服务出去的字节本来就该是 LF。
apps/mobile/src/** text eol=lf
# 此共享源码也会原样内联进手机生成页。
apps/desktop/src/shared/task-entry-contract.js text eol=lf
src/daemon/mobile-page.generated.json text eol=lf

# 「CC 眼中的你」眨眼帧:二进制原样进出(同 pet 资产)。
apps/mobile/art/** -text

# 公网中继壳页(手机协议包 v2 Task 4):relay/pset.html 是从 relay/pset.src.html
# 生成的,apps/mobile/build.test.ts 同理按整份文本比对,同上理由钉死 LF。
relay/pset.src.html text eol=lf
relay/pset.html text eol=lf
# 生成物:scripts/design-tokens.guard.test.ts 按整份文本比对 renderTokensCss(),autocrlf 改成 CRLF 后必红(windows-latest)。
apps/desktop/src/tokens.css text eol=lf
